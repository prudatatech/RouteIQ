# Copy to .env for local development; for EAS builds/updates set these as EAS environment variables.
# Never put the Supabase service_role key (or any secret) here: EXPO_PUBLIC_* values are bundled into the app.

# Base URL of the RouteIQ backend API, without /api/v1 (e.g. https://api.example.com).
EXPO_PUBLIC_API_URL=https://staging-api.margixindia.com   # live builds: https://api.margixindia.com

# Supabase project URL (Project Settings -> API).
EXPO_PUBLIC_SUPABASE_URL=https://staging-data.margixindia.com   # live builds: https://data.margixindia.com

# Supabase anon (public) key -- NOT the service_role key; the app refuses to start with a non-anon key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Maps SDK key restricted to the com.margixindia.driverapp Android/iOS apps.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
