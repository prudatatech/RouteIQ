# Copy to infra/secrets.env (gitignored) and fill in. One KEY=value per line, no quotes needed.
# Blank keys are skipped with a warning (the matching feature stays off).
# deploy.sh and set-secrets.sh apply this file to the api app; the ml app gets only the two Supabase keys.
# Keys starting VITE_ are used at frontend build time and are NOT sent to Azure.

# ---- Core (the API will not work properly without these) ----
# Supabase dashboard > Project Settings > API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase dashboard > Project Settings > API > JWT Settings > JWT Secret.
SUPABASE_JWT_SECRET=
# Any long random string for backend-signed tokens: openssl rand -hex 32
SECRET_KEY=
# Keyed-hash salt for Aadhaar/PAN/licence duplicate detection. Required in production.
# openssl rand -hex 32. Never change it after go-live or duplicate detection breaks.
PEOPLE_HASH_SALT=

# ---- Maps, traffic, weather ----
# developer.tomtom.com > Dashboard > Keys (traffic incidents, reroute suggestions).
TOMTOM_API_KEY=
# account.mapbox.com > Access tokens (server side road directions for every map; a secret sk. token is fine here).
# Maps draw roads through the API (POST /routing/directions): Mapbox first, TomTom as the fallback.
# The web build needs NO map token (VITE_MAPBOX_TOKEN is no longer used).
MAPBOX_ACCESS_TOKEN=
# console.cloud.google.com > APIs & Services > Credentials.
GOOGLE_MAPS_API_KEY=
# apis.mappls.com > Console > Credentials.
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
# openweathermap.org > API keys.
OPENWEATHER_API_KEY=

# ---- Government / cargo network ----
# ULIP portal (ulip.dpiit.gov.in) registration.
ULIP_CLIENT_ID=
ULIP_CLIENT_SECRET=
# Your GST Suvidha Provider (e-way bill / GSTIN search). Base URL and credentials come from the GSP.
EWAYBILL_GSP_BASE_URL=
EWAYBILL_GSP_USERNAME=
EWAYBILL_GSP_PASSWORD=
EWAYBILL_GSP_CLIENT_ID=

# ---- Telematics / GPS ----
# Bearer token or HMAC secret you give the telematics vendor for POST /telematics/webhook: openssl rand -hex 32
FLEET_TELEMATICS_WEBHOOK_SECRET=
# Roadcast / SparkGPS account portal.
SPARK_GPS_API_TOKEN=
SPARK_GPS_USERNAME=
SPARK_GPS_PASSWORD=
# Secret the provider sends when pushing positions to POST /spark-gps (you choose it: openssl rand -hex 32).
SPARK_GPS_PUSH_SECRET=

# ---- Messaging ----
# resend.com > API Keys (emails: 3PL OTP, invitations).
RESEND_API_KEY=
# console.twilio.com (driver OTP by SMS).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- Redis (what backend-ts uses today) ----
# backend-ts talks to Redis over Upstash REST, not REDIS_URL. console.upstash.com > your database > REST API.
# Blank is fine: the backend falls back to an in-memory cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
