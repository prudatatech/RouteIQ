# Deployment settings. Committed on purpose: nothing secret and nothing tied to one account.
# Edit these, then run ./infra/deploy.sh

# Leave empty to use whatever `az account show` currently points at.
# Set it (a GUID) if you have more than one subscription.
SUBSCRIPTION_ID=

# Region for the resource group, Container Apps, ACR, Log Analytics.
LOCATION=centralindia

# Static Web Apps is not offered in Central India. Used only for the <prefix>-web resource.
WEB_LOCATION=eastasia

# Names become <PREFIX>-rg, <PREFIX>-api, <PREFIX>-ml, <PREFIX>-web (2 to 12 chars).
PREFIX=margix

# Budget alerts (at 50, 100 and 150 of a 200 budget) go here. Empty skips the budget.
BUDGET_EMAIL=

# Optional. Web custom domain (e.g. margixindia.com): used for CORS and WEB_APP_URL.
# DNS and the domain binding are manual steps, see infra/README.md.
CUSTOM_DOMAIN=portal.margixindia.com

# Optional. Custom domain of the API (e.g. api.margixindia.com). When set, the frontend is built
# against it instead of the *.azurecontainerapps.io address.
API_DOMAIN=api.margixindia.com

# Sign-in, data, realtime and files gateway of the live stage (infra/platform.sh).
DATA_DOMAIN=data.margixindia.com

# The test stage's own names (used when --stage test).
TEST_CUSTOM_DOMAIN=staging.margixindia.com
TEST_API_DOMAIN=staging-api.margixindia.com
TEST_DATA_DOMAIN=staging-data.margixindia.com

# Database server size per stage (infra/database.bicep). Burstable B2s = 2 vCPU, 4 GiB.
PG_SKU=Standard_B2s
TEST_PG_SKU=Standard_B1ms
