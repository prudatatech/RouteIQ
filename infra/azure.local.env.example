# Copy to infra/azure.local.env (gitignored) and fill in for the Azure account you deploy to.
# Find the id with: az account list --query "[].{name:name,id:id,user:user.name}" -o table
SUBSCRIPTION_ID=
# Where budget alerts ($50 / $100 / $150) are sent
BUDGET_EMAIL=
# Optional. Postgres server names are global across Azure: while an old account still holds margix-pg /
# margix-test-pg, give this account's servers other names.
# LIVE_PG_SERVER=margix-pg-south
# TEST_PG_SERVER=margix-test-pg-south
# Optional. A region for the Postgres servers when LOCATION has no capacity for this account (SkuNotAvailable).
# PG_LOCATION=southindia
