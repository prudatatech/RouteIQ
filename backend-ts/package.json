{
  "name": "margixindia-backend",
  "version": "1.0.0",
  "description": "margixindia Fleet Intelligence Platform — TypeScript Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "ts-node src/scripts/seed.ts",
    "check:queries": "ts-node --transpile-only scripts/check-queries.ts"
  },
  "dependencies": {
    "@mapbox/polyline": "^1.2.1",
    "@supabase/supabase-js": "^2.109.0",
    "@upstash/redis": "^1.38.2",
    "axios": "^1.18.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "expo-server-sdk": "^6.1.0",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.20.2",
    "resend": "^6.26.0",
    "uuid": "^10.0.0",
    "ws": "^8.21.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "supertest": "^7.3.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0",
    "undici": "^7.2.0",
    "vitest": "^4.1.11"
  }
}
