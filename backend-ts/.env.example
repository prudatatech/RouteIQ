# Distances, traffic and weather (each one is optional; a missing key shows "not configured" in the app)
GOOGLE_MAPS_API_KEY=
TOMTOM_API_KEY=
OPENWEATHER_API_KEY=
# Traffic check along active routes, in minutes, and the smallest delay (minutes) that raises a reroute suggestion
TRAFFIC_REFRESH_MINUTES=10
TRAFFIC_MIN_DELAY_MINUTES=5


# Cargo Network APIs
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
ULIP_CLIENT_ID=
ULIP_CLIENT_SECRET=
EWAYBILL_GSP_USERNAME=
EWAYBILL_GSP_PASSWORD=
EWAYBILL_GSP_CLIENT_ID=
# Secures POST /api/v1/telematics/webhook (Bearer token or HMAC signature; see docs/telematics-webhook.md). Empty = webhook off (503).
FLEET_TELEMATICS_WEBHOOK_SECRET=

# 3PL document uploads (POST /tpl/applications/upload-url)
KYC_DOCUMENTS_BUCKET=kyc_documents
TPL_UPLOAD_MAX_BYTES=2097152
TPL_UPLOAD_URLS_PER_HOUR=30
