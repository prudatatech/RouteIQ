# Backend API base URL (no trailing slash, no /api/v1 suffix). Required.
EXPO_PUBLIC_API_URL=https://staging-api.margixindia.com   # live builds: https://api.margixindia.com

# Google Maps API key used natively by react-native-maps (Android + iOS). Required for maps to render.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# EAS project id (from `eas init`). Push notifications need it to get a device token; without it the app builds but no pushes register.
EAS_PROJECT_ID=your-eas-project-id
