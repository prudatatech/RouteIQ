{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/geo/*",
      "/*.json",
      "/*.png",
      "/*.jpg",
      "/*.jpeg",
      "/*.svg",
      "/*.ico",
      "/*.webp",
      "/*.css",
      "/*.js",
      "/*.map",
      "/*.geojson",
      "/*.woff",
      "/*.woff2",
      "/robots.txt"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Content-Security-Policy": "frame-ancestors 'self'",
    "Permissions-Policy": "camera=(self), microphone=(self), geolocation=(self)"
  }
}
