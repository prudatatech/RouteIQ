{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/geo/*",
      "/*.json",
      "/*.png",
      "/*.jpg",
      "/*.jpeg",
      "/*.svg",
      "/*.ico",
      "/*.webp",
      "/*.css",
      "/*.js",
      "/*.map",
      "/*.geojson",
      "/*.woff",
      "/*.woff2",
      "/robots.txt"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff"
  }
}
