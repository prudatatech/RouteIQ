# --------Frontend---------
VITE_MAPBOX_TOKEN=your_mapbox_token
VITE_MAPBOX_GEOCODING_URL=https://api.mapbox.com/geocoding/v5/mapbox.places

# Map Defaults
VITE_MAP_CENTER_LNG=81.0
VITE_MAP_CENTER_LAT=22.5
VITE_MAP_ZOOM=4.2

# API Proxy
VITE_PROXY_TARGET=https://margixindia-production-45a7.up.railway.app
VITE_API_URL=https://margixindia-production-45a7.up.railway.app/api/v1
VITE_ENABLE_MOBILE_GPS=true
# Supabase
# Direct URL for auth
VITE_SUPABASE_DIRECT_URL=https://plutdajzefwtpgofpqlk.supabase.co
VITE_SUPABASE_URL=https://plutdajzefwtpgofpqlk.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# -------margixindia Google Auth----
# Google OAuth configuration
DEFAULT_GOOGLE_ROLE=admin
GOOGLE_CLIENT_ID=your_google_client_id
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Optional: only if your backend requires the client secret
GOOGLE_CLIENT_SECRET=your_google_client_secret

