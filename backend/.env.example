# External APIs
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
OPENWEATHER_API_KEY=your_openweather_api_key
TOMTOM_API_KEY=your_tomtom_api_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# SparkGPS (Roadcast)
SPARK_GPS_API_URL=https://api.roadcast.in/v1
SPARK_GPS_API_TOKEN=your_spark_gps_token
SPARK_GPS_USERNAME=your_spark_gps_username
SPARK_GPS_PASSWORD=your_spark_gps_password

# AWS
AWS_REGION=ap-south-1
AWS_S3_BUCKET=margixindia-assets

# Mapbox
MAPBOX_ACCESS_TOKEN=your_mapbox_token

# Python ML Service
ML_SERVICE_URL=http://127.0.0.1:8001

# Twilio (Driver OTP Auth)
# Leave empty for dev mode — OTP will be logged to console
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6

# Feature Flags
ENABLE_MOBILE_GPS=false
ENABLE_HARDWARE_SYNC=false

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3005,http://localhost:5173,http://localhost:5174,http://localhost:8001